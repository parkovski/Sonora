<suki:SukiWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:suki="https://github.com/kikipoulet/SukiUI"
                 xmlns:vm="using:Sonora.ViewModels"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:views="using:Sonora.Views"
                 xmlns:ctrl="using:Sonora.Controls"
                 xmlns:conv="using:Sonora.Converters"
                 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                 x:Class="Sonora.Views.MainWindow"
                 x:DataType="vm:MainViewModel"
                 BackgroundStyle="GradientSoft"
                 Icon="/Assets/saguaro.ico"
                 Title="Sonora">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>
    <Control.Resources>
        <conv:PathToWaveConverter x:Key="WaveConverter"/>
    </Control.Resources>

    <suki:SukiSideMenu>
        <suki:SukiSideMenu.Items>
            <suki:SukiSideMenuItem Header="Wave Viewer">
                <suki:SukiSideMenuItem.Icon>
                    <ctrl:ThemeIcon Path="avares://Sonora/Assets/wave-saw-tool.png"/>
                </suki:SukiSideMenuItem.Icon>
                <suki:SukiSideMenuItem.PageContent>
                    <Grid ColumnDefinitions="*,4,2*">
                        <views:FilesView Grid.Column="0" DataContext="{Binding Files}"/>
                        <GridSplitter Grid.Column="1" Background="Black" ResizeDirection="Columns"/>
                        <DockPanel Grid.Column="2">
                            <ctrl:WaveControl Wave="{Binding Files.SelectedFile, Converter={StaticResource WaveConverter}}"/>
                        </DockPanel>
                    </Grid>
                </suki:SukiSideMenuItem.PageContent>
            </suki:SukiSideMenuItem>
            <suki:SukiSideMenuItem Header="MIDI Settings">
                <suki:SukiSideMenuItem.Icon>
                    <ctrl:ThemeIcon Path="avares://Sonora/Assets/piano.png"/>
                </suki:SukiSideMenuItem.Icon>
                <suki:SukiSideMenuItem.PageContent>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Orientation="Vertical">
                            <TextBlock>MIDI Inputs</TextBlock>
                            <ListBox x:Name="midiInListBox"/>
                        </StackPanel>
                        <StackPanel Orientation="Vertical">
                            <TextBlock>MIDI Outputs</TextBlock>
                            <ListBox x:Name="midiOutListBox"/>
                        </StackPanel>
                    </StackPanel>
                </suki:SukiSideMenuItem.PageContent>
            </suki:SukiSideMenuItem>
        </suki:SukiSideMenu.Items>
        <suki:SukiSideMenu.HeaderContent>
        </suki:SukiSideMenu.HeaderContent>
        <suki:SukiSideMenu.FooterContent>
        </suki:SukiSideMenu.FooterContent>
    </suki:SukiSideMenu>
</suki:SukiWindow>
